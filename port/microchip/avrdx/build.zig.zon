.{
    .name = .mz_port_microchip_avrdx,
    .fingerprint = 0xdec2986317af69db,
    .version = "0.0.0",
    .dependencies = .{
        .@"microzig/build-internals" = .{ .path = "../../../build-internals" },
        // The AVR-Dx device pack is vendored rather than fetched: Microchip's
        // pack server sends `application/vnd.atmel.atpack`, which the Zig
        // package fetcher rejects, and the microzig.tech mirror does not carry
        // this family. vendor/atdf/AVR32DD20.atdf is extracted from
        // Microchip.AVR-Dx_DFP.2.8.343.atpack
        //   SHA-256 d81af59072e5ac188431e828461eee5c08e6d5f3ace32461328b4da0ec348746
        //   size    16,766,508 bytes
        // and the vendored file itself hashes to
        //   SHA-256 5b7fc47eed2d281b3c2b6553b2629a8d19195fa62dd9a0288caa92752a8f9d32
        // scripts/verify_avr32dd20_sources.sh re-derives both hashes.
    },
    .paths = .{
        "README.md",
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
